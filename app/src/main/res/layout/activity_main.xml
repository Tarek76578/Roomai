<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoomAI"
            android:textColor="#171717"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="AI Interior Designer"
            android:textColor="#777777"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Redesign your space"
            android:textColor="#171717"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Upload a photo and discover how your room could look with AI."
            android:textColor="#666666"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/roomImage"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="22dp"
            android:background="#E8E5DE"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/uploadButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="📷  Add Room Photo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Room type"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/roomTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Design style"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/styleSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="What would you like to change?"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/requestInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="7dp"
            android:gravity="top"
            android:hint="Example: Make it modern, brighter and more spacious..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/designButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:text="✨  Generate Design"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
